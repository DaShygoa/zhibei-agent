# ===== 大模型（OpenAI 兼容接口）=====
# 通义千问 DashScope：https://dashscope.console.aliyun.com/apiKey
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
# 换 DeepSeek：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 换本地 Ollama：LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama

# ===== Agent 运行约束 =====
MAX_AGENT_STEPS=12
HISTORY_WINDOW=16

# ===== 可观测性 Langfuse（可选，三项都填才启用）=====
# 免费注册：https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
